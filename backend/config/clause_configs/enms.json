    {"clause_id": "6.1", "title": "Actions to address risks and opportunities", "applicability": "always_applicable"},
    {"clause_id": "6.2", "title": "Objectives, energy targets and planning", "applicability": "always_applicable"},
    {"clause_id": "6.3", "title": "Energy review", "applicability": "always_applicable"},
