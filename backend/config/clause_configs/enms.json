    {"clause_id": "8.2", "title": "Design", "applicability": "scope_conditional", "condition": "Applicable if the organization designs facilities, equipment, systems or processes that affect energy performance. Not applicable if the organization has no design activity influencing energy use."},
    {"clause_id": "8.3", "title": "Procurement", "applicability": "scope_conditional", "condition": "Applicable if the organization procures energy-using products, equipment or services. Not applicable only if no such procurement exists within the EnMS scope."},
