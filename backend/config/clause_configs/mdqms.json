    {"clause_id": "7.3", "title": "Design and development", "applicability": "scope_conditional", "condition": "Applicable only if the organization performs design and development of medical devices. Not applicable if design and development is fully excluded from the defined scope and justified per regulatory requirements."},
    {"clause_id": "7.4", "title": "Purchasing", "applicability": "scope_conditional", "condition": "Applicable if the organization purchases any products or services that affect product conformity. Not applicable only if no external purchasing exists."},
    {"clause_id": "7.5", "title": "Production and service provision", "applicability": "always_applicable"},
    {"clause_id": "7.6", "title": "Control of monitoring and measuring equipment", "applicability": "scope_conditional", "condition": "Applicable if the organization uses monitoring or measuring equipment to verify product conformity. Not applicable only if no such equipment is used."},
