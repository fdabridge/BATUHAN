{
  "accreditation_body": "IAF",
  "display_name": "IAF-aligned baseline",
  "governing_standard": "ISO/IEC 17021-1:2015",
  "reference_basis": [
    "ISO/IEC 17021-1:2015-based certification audit report controls",
    "IAF mandatory document themes for audit duration, multi-site sampling, ICT/remote auditing, and certification decision support",
    "Selected management system standard clause map",
    "Internal Certiva audit-report quality rules"
  ],

  "nc_classifications": {
    "major": "A nonconformity that affects the ability of the management system to achieve its intended results.",
    "minor": "A nonconformity that does not affect the ability of the management system to achieve its intended results but requires correction and corrective action.",
    "critical": "A legal, regulatory, product safety, food safety, health and safety, or certification-integrity issue that may require immediate escalation.",
    "observation": "An evidence-based statement that may support improvement or next-audit planning but is not a nonconformity."
  },

  "required_report_elements": [
    "audit_scope",
    "audit_objectives",
    "audit_criteria",
    "audit_dates_and_sites",
    "audit_team_members_and_roles",
    "audit_time_or_sampling_rationale_when_relevant",
    "findings_per_clause_with_evidence",
    "nc_list_with_classification_and_clause",
    "observations_list",
    "certification_or_continuation_recommendation"
  ],

  "stage_requirements": {
    "stage_1": {
      "mandatory_coverage": [
        "documented_information_status",
        "readiness_for_stage_2_assessment",
        "internal_audit_and_management_review_status",
        "areas_likely_to_be_ncs_in_stage_2",
        "scope_of_certification_confirmed",
        "legal_and_regulatory_requirements_identified"
      ],
      "nc_types_allowed": ["major", "minor", "observation"],
      "site_visit_required": false,
      "clause_coverage": "documentation_focused"
    },
    "stage_2": {
      "mandatory_coverage": [
        "all_clauses_of_selected_standard",
        "operational_control_evidence",
        "internal_audit_and_management_review_evidence",
        "legal_regulatory_compliance_evidence",
        "management_responsibility_evidence",
        "process_effectiveness_evidence",
        "certification_recommendation_supported_by_findings"
      ],
      "nc_types_allowed": ["major", "minor", "critical", "observation"],
      "site_visit_required": true,
      "clause_coverage": "all_clauses_mandatory"
    },
    "surveillance": {
      "mandatory_coverage": [
        "continued_effectiveness_of_management_system",
        "follow_up_of_previous_nonconformities",
        "changes_to_scope_processes_sites_or_legal_requirements",
        "complaints_and_appeals_review",
        "internal_audit_and_management_review_evidence",
        "certificate_continuation_recommendation_supported_by_findings"
      ],
      "nc_types_allowed": ["major", "minor", "critical", "observation"],
      "site_visit_required": true,
      "clause_coverage": "sampled_clauses_plus_changes_and_previous_issues"
    },
    "recertification": {
      "mandatory_coverage": [
        "full_cycle_performance_review",
        "continued_fulfilment_of_all_standard_requirements",
        "previous_cycle_nc_and_corrective_action_effectiveness",
        "changes_to_scope_processes_sites_or_legal_requirements",
        "recertification_recommendation_supported_by_findings"
      ],
      "nc_types_allowed": ["major", "minor", "critical", "observation"],
      "site_visit_required": true,
      "clause_coverage": "all_clauses_mandatory"
    }
  },

  "audit_logic_checks": [
    "The recommendation must be supported by objective evidence and cannot contradict NC status.",
    "Scope, standards, sites, dates, audit team, audit duration, and sampled activities must be internally consistent.",
    "Major nonconformities cannot be left open when the report recommends certification, recertification, or continuation.",
    "Multi-site reports must explain sampling logic and central function coverage when applicable.",
    "Remote or ICT-assisted audits must identify the remote method and evidence reliability when applicable."
  ],

  "finding_depth_requirements": {
    "minimum_finding_length_words": 25,
    "must_reference_evidence": true,
    "evidence_must_be_specific": true,
    "evidence_types_accepted": [
      "document_reference",
      "record_reference",
      "interview_reference",
      "observation_of_process",
      "site_observation",
      "measurement_or_test_result"
    ],
    "vague_finding_patterns": [
      "satisfactory",
      "adequate",
      "good",
      "acceptable",
      "in order",
      "found to be compliant",
      "no issues found",
      "meets requirements",
      "generally conforming",
      "appears to be"
    ]
  },

  "nc_rules": {
    "major_nc_must_be_closed_before_certification": true,
    "minor_nc_requires_corrective_action_plan": true,
    "nc_must_reference_specific_clause": true,
    "nc_must_state_objective_evidence": true,
    "nc_must_not_be_vague": true,
    "nc_objective_evidence_must_be_specific": true
  },

  "standard_specific_rules": {
    "ENMS": {
      "required_statements": [
        "Explicit statement that continuous improvement of the EnMS has been achieved with supporting audit evidence.",
        "Explicit statement that continuous energy performance improvement has been achieved with supporting audit evidence.",
        "SEUs audited with evidence of controls."
      ]
    },
    "ISMS": {
      "required_elements": [
        "Statement of Applicability referenced or reviewed",
        "Risk treatment plan evidence",
        "Annex A control coverage addressed",
        "Incident management records reviewed where applicable"
      ]
    },
    "FSMS": {
      "required_elements": [
        "PRP analysis and PRP verification evidence, not just a generic PRP mention",
        "Hazard analysis evidence including hazard identification and assessment",
        "HACCP/OPRP plan review with CCP/OPRP monitoring evidence where applicable",
        "Traceability system evidence with a specific tested example",
        "Verification related to PRPs and control measures"
      ]
    },
    "MDQMS": {
      "required_elements": [
        "Design and development exclusion justified if claimed",
        "Regulatory compliance evidence where applicable",
        "Post-market surveillance evidence where applicable"
      ]
    }
  },

  "multisite_rules": {
    "sampling_plan_required": true,
    "sampling_rationale_must_be_documented": true,
    "all_sites_same_scope_required": true,
    "central_function_audit_required": true
  },

  "forbidden_in_findings": [
    "satisfactory",
    "adequate",
    "good system",
    "no issues",
    "meets all requirements",
    "fully compliant",
    "everything is in order",
    "appears compliant",
    "generally conforming"
  ],

  "severity_levels": ["CRITICAL", "MAJOR", "MINOR", "WARNING", "OK"],

  "review_check_types": [
    "MISSING_SECTION",
    "WEAK_EVIDENCE",
    "NC_MISCLASSIFICATION",
    "VAGUE_FINDING",
    "MISSING_NC_CLAUSE_REF",
    "MISSING_NC_RATIONALE",
    "PLACEHOLDER",
    "FORBIDDEN_PHRASE",
    "STANDARD_SPECIFIC_MISSING",
    "INSUFFICIENT_EVIDENCE_SPECIFICITY",
    "OK"
  ]
}
