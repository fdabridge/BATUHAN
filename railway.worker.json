{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "dockerContext": "backend",
    "watchPatterns": [
      "/backend/**",
      "!/backend/standalone_tracker/**",
      "!/backend/tests/**",
      "/railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "celery -A jobs.tasks worker --loglevel=info --concurrency=2",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

